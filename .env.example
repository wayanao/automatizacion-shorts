# --- OpenAI (guion, voz TTS y transcripcion whisper) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Pexels (videos de fondo, gratis: https://www.pexels.com/api/) ---
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- YouTube Data API (OAuth) ---
YT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
YT_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Opcional ---
# Visibilidad del video subido: public | unlisted | private
YT_PRIVACY_STATUS=public
